# Shared environment variable reference
# Copy the appropriate example file for your environment:
#   .env.local.example  -> .env.local       (local development)
#   .env.staging.example -> .env.staging     (staging deployments)
#   .env.production.example -> .env.production (production deployments)

# App
# Production: https://curbfare.app — auth email links are built from this.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEVER "development" in production: it enables the Mailpit dev helpers.
NEXT_PUBLIC_APP_ENV=development

# Supabase (public keys only — safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google (required outside development). The browser Maps key must list the
# production domain under allowed websites or maps/autocomplete fail silently.
# GOOGLE_PLACES_API_KEY=your-google-places-api-key
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-maps-key

# Vendor application doorbell (optional; unset = log-only, nothing breaks).
# Resend sandbox delivers only to your Resend signup address until the
# sending domain is verified — see docs/DEPLOYMENT.md.
# RESEND_API_KEY=your-resend-api-key
# VENDOR_REVIEW_NOTIFY_EMAIL=vendors@curbfare.app
# VENDOR_REVIEW_FROM_EMAIL=applications@curbfare.app
